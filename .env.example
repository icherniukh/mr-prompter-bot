TELEGRAM_BOT_TOKEN=

# OpenRouter API key used to call free-tier OpenRouter models (OPENROUTER_API_KEY or HOST_OPENROUTER_KEY).
OPENROUTER_API_KEY=

# Optional override for the OpenRouter API base URL.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional preferred free OpenRouter model (must end with :free or equal openrouter/free).
# Leave unset to let the bot dynamically discover and cache active :free models from OpenRouter's /models catalog.
#OPENROUTER_MODEL=
