TELEGRAM_BOT_TOKEN=

# Gemini API key for the Telegram bot's Gemini backend.
# Also used by scripts/gemini_25_free_watermark_remover.py.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional override for the Gemini image model used by the Telegram bot.
GEMINI_MODEL=gemini-2.5-flash-image

# Optional override for the Real-ESRGAN ONNX model used by auto-Full-HD
# upscaling. Fetch the default with scripts/download_sr_model.sh; without it
# the bot falls back to Lanczos resizing.
#SR_MODEL_PATH=models/realesr-general-x4v3.onnx

# Support recipient configuration (used by /support)
SUPPORT_ACCOUNT=@kappa_alive
#SUPPORT_CHAT_ID=

# Text-to-speech voice override (used by /speak)
#TTS_VOICE=en-US-ChristopherNeural
