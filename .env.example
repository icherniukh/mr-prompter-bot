TELEGRAM_BOT_TOKEN=

# Gemini API key for the Telegram bot's Gemini backend.
# Also used by scripts/gemini_25_free_watermark_remover.py.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional override for the Gemini image model used by the old paid single-call
# fallback (remove_overlays_gemini_paid); not used by the default free pipeline.
GEMINI_MODEL=gemini-2.5-flash-image

# Optional override for the free-tier Gemini vision model used to locate
# overlays before local inpainting.
#GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional override for the MI-GAN ONNX model used for local overlay removal.
# Fetch the default with scripts/download_migan_model.sh.
#MIGAN_MODEL_PATH=models/migan_pipeline_v2.onnx

# Optional override for the Real-ESRGAN ONNX model used by auto-Full-HD
# upscaling. Fetch the default with scripts/download_sr_model.sh; without it
# the bot falls back to Lanczos resizing.
#SR_MODEL_PATH=models/realesr-general-x4v3.onnx

# Support recipient configuration (used by /support)
SUPPORT_ACCOUNT=@kappa_alive
#SUPPORT_CHAT_ID=

# Text-to-speech voice override (used by /speak)
#TTS_VOICE=en-US-ChristopherNeural
